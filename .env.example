# Токен от @BotFather
BOT_TOKEN=123456:ABC-your-token
# ID админов через запятую (свой ID: @userinfobot)
ADMIN_IDS=111111111
# Публичный https-адрес мини-приложения (тот же сервер, порт 8080 за HTTPS-прокси)
WEBAPP_URL=https://game.example.com
# Короткое имя Mini App из BotFather (/newapp), если создашь — рефссылки откроют игру сразу
WEBAPP_SHORT_NAME=
# Магазин за Telegram Stars (попытки и удача). Включай после проверки юристом, см. README
STARS_ENABLED=0
# Кому писать за рекламой (без @). Пока свою рекламу не поставили через /ad, на главном экране заглушка с этим контактом
ADS_CONTACT=
DB_PATH=data/bot.db
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Только для локальной отладки: пускать запросы с заголовком "dev <id>" без Telegram
DEV_AUTH=0
